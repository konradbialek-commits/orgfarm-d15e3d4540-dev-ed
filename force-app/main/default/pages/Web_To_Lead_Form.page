<apex:page showHeader="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" docType="html-5.0">
<html lang="en">
    <head>
        <meta http-equiv="Content-type" content="text/html; charset=UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link
            rel="shortcut icon"
            href="{!$Resource.SiteFavicon}"
            type="image/x-icon"
        />
        <title>BookSmart Contact Form</title>
        <style>
            body {
                font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
                line-height: 1.4;
                margin: 2rem 0 0 0;
                display: flex;
                flex-direction: column;
                background: url("https://i.postimg.cc/3N2751xX/booksmart-background-resized.png")
                    center center / cover no-repeat;
                color: #333;
            }

            .main {
                display: flex;
                justify-content: center;
                align-items: center;
                flex: 1;
                min-height: 80vh;
            }

            form {
                background: rgba(255, 255, 255, 0.75);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                max-width: 800px;
                min-width: 600px;
                padding: 1.5rem;
                border-radius: 10px;
                box-shadow: 0 6px 18px rgba(33, 53, 90, 0.12);
                border: 1px solid rgba(226, 230, 238, 0.6);
                transition:
                    background 0.5s ease,
                    height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            }

            h1 {
                text-align: center;
                font-size: 2.5rem;
                margin-bottom: 1.5rem;
                color: #1f2a44;
                font-weight: 700;
            }

            img {
                display: block;
                max-width: 300px;
                height: auto;
                margin: 0 auto 1.5rem;
            }

            label {
                display: block;
                margin-bottom: 0.35rem;
                font-weight: 600;
                color: #1f2a44;
            }

            .form-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 0.9rem 1.1rem;
            }

            .form-grid .field {
                display: flex;
                flex-direction: column;
            }

            @media (max-width: 768px) {
                .form-grid {
                    grid-template-columns: 1fr;
                }
                form {
                    max-width: 90%;
                    min-width: auto;
                    padding: 1.2rem;
                }
                h1 {
                    font-size: 2.2rem;
                }
                body {
                    margin: 1.5rem 0 0 0;
                }
            }

            @media (max-width: 480px) {
                form {
                    max-width: 95%;
                    padding: 1rem;
                }
                h1 {
                    font-size: 1.8rem;
                }
                body {
                    margin: 1rem 0 0 0;
                }
                .info-message {
                    font-size: 0.85rem;
                }
                .footer {
                    padding: 0.5rem 0;
                    font-size: 0.8rem;
                }
                .form-grid {
                    gap: 0.7rem 0.8rem;
                }
                .field {
                    margin-bottom: 0.8rem;
                }
                input[type="text"],
                input[type="tel"],
                input[type="email"],
                select {
                    padding: 0.5rem 0.6rem;
                    margin-bottom: 0.7rem;
                }
                .field label {
                    top: 0.5rem;
                    left: 0.6rem;
                }
                .checkmark {
                    right: 0.6rem;
                    top: 0.5rem;
                }
                .form-actions button {
                    padding: 0.5rem 0.8rem;
                }
            }

            input[type="text"],
            input[type="tel"],
            input[type="email"],
            select {
                width: 100%;
                box-sizing: border-box;
                padding: 0.55rem 0.65rem;
                margin-bottom: 0.9rem;
                border: 1px solid #c7d0e2;
                border-radius: 5px;
                background: #fff;
            }

            .errmsg {
                display: none;
                align-items: center;
                gap: 5px;
                font-size: 12px;
                font-weight: 500;
                color: var(--red);
                margin-top: 5px;
            }
            .errmsg.show {
                display: flex;
            }
            .errmsg svg {
                flex-shrink: 0;
            }

            input[type="text"]:focus,
            input[type="tel"]:focus,
            input[type="email"]:focus,
            select:focus {
                outline: none;
                border-color: #5586f6;
                box-shadow: 0 0 0 2px rgba(85, 134, 246, 0.15);
            }

            button.btn {
                background: #2e67e6;
                color: #fff;
                border: none;
                border-radius: 6px;
                padding: 0.7rem 1.1rem;
                cursor: pointer;
                transition: background 0.2s ease;
                font-weight: 700;
                width: 100%;
                margin-top: 0.5rem;
            }

            .btn:disabled {
                background: #93c5fd;
                cursor: not-allowed;
                box-shadow: none;
            }

            input[type="submit"]:hover {
                background: #254fbe;
            }

            .required::after {
                content: " *";
                color: #dc3545;
                font-weight: 700;
            }

            input[required]:invalid,
            select[required]:invalid {
                border-color: #dc3545 !important;
            }

            .footer {
                position: fixed;
                left: 0;
                bottom: 0;
                width: 100%;
                margin: 0;
                padding: 0.8rem 0;
                text-align: center;
                color: #334155;
                font-size: 0.9rem;
                background: rgba(255, 255, 255, 0.72);
                backdrop-filter: blur(10px);
                border-top: 1px solid rgba(226, 230, 238, 0.6);
                z-index: 10;
            }

            .info-message {
                text-align: center;
                margin: 1rem 0;
                font-size: 0.9rem;
                color: #6f7a8a;
            }

            .progress-container {
                width: 100%;
                height: 8px;
                background: #e2e6ee;
                border-radius: 4px;
                margin: 1rem 0;
                overflow: hidden;
            }

            .progress-bar {
                height: 100%;
                background: linear-gradient(to right, #2e67e6, #5586f6);
                width: 0%;
                transition: width 0.3s ease;
            }

            /* Step-by-Step Wizard - Flashcard Flip */
            .steps-wrapper {
                position: relative;
                perspective: 1500px; /* Creates the 3D depth */
                transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            }

            form[data-step="1"] {
                background: rgba(255, 255, 255, 0.35);
            }
            form[data-step="2"] {
                background: rgba(244, 248, 255, 0.4);
            }
            form[data-step="3"] {
                background: rgba(245, 255, 245, 0.4);
            }

            .step {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                opacity: 0;
                transform-origin: center; /* Pivots cleanly in the middle */
                transform: rotateY(90deg) scale(0.95); /* Starts folded sideways and slightly smaller */
                transition:
                    transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                    opacity 0.3s ease;
                pointer-events: none;
                z-index: 1;
            }

            .step.active {
                opacity: 1;
                transform: rotateY(0deg) scale(1); /* Unfolds completely flat */
                pointer-events: auto;
                z-index: 2;
                transition-delay: 0.15s; /* Waits a split second for the old page to get out of the way */
            }

            .step.leaving {
                opacity: 0;
                transform: rotateY(-90deg) scale(0.95); /* Folds away to the other side */
                z-index: 1;
            }

            .step.entering {
                z-index: 2;
            }
            .step-indicator {
                display: flex;
                justify-content: center;
                gap: 1rem;
                margin: 1rem 0;
            }
            .step-circle {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: #e2e6ee;
                color: #6f7a8a;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                transition: all 0.3s ease;
            }
            .step-circle.active {
                background: #2e67e6;
                color: #fff;
            }
            .step-circle.completed {
                background: #28a745;
                color: #fff;
            }
            .form-actions {
                display: flex;
                justify-content: space-between;
                margin-top: 1rem;
            }
            .form-actions button {
                padding: 0.5rem 1rem;
                border: none;
                border-radius: 5px;
                cursor: pointer;
                font-weight: 600;
            }
            #prev-btn {
                background: #6c757d;
                color: #fff;
            }
            #prev-btn:disabled {
                background: #adb5bd;
                cursor: not-allowed;
            }
            #next-btn {
                background: #2e67e6;
                color: #fff;
            }
            #submit-btn {
                background: #28a745;
                color: #fff;
                display: none;
            }

            /* Micro-Interactions: Floating Labels */
            .field {
                position: relative;
                margin-bottom: 1rem;
            }
            .field label {
                position: absolute;
                top: 0.55rem;
                left: 0.65rem;
                background: #fff;
                padding: 0 0.2rem;
                transition: all 0.2s ease;
                pointer-events: none;
                color: #6f7a8a;
            }
            .field input:focus + label,
            .field input:not([value=""]) + label,
            .field select:focus + label,
            .field select:not([value=""]) + label {
                top: -0.5rem;
                font-size: 0.8rem;
                color: #5586f6;
            }
            .field input:focus,
            .field select:focus {
                border-color: #5586f6;
                box-shadow: 0 0 0 2px rgba(85, 134, 246, 0.15);
            }

            /* Success Checkmarks */
            .checkmark {
                position: absolute;
                right: 0.65rem;
                top: 0.55rem;
                color: #28a745;
                font-size: 1.2rem;
                opacity: 0;
                transition: opacity 0.3s ease;
            }
            .field.is-valid .checkmark {
                opacity: 1;
            }

            /* Error Shake */
            .shake {
                animation: shake 0.5s ease-in-out;
            }
            @keyframes shake {
                0%,
                100% {
                    transform: translateX(0);
                }
                25% {
                    transform: translateX(-5px);
                }
                75% {
                    transform: translateX(5px);
                }
            }

            /* Confetti */
            .confetti {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                pointer-events: none;
                z-index: 1000;
            }
            .confetti-piece {
                position: absolute;
                width: 10px;
                height: 10px;
                background: #ff6b6b;
                animation: fall 3s linear infinite;
            }
            .confetti-piece:nth-child(2n) {
                background: #4ecdc4;
            }
            .confetti-piece:nth-child(3n) {
                background: #45b7d1;
            }
            .confetti-piece:nth-child(4n) {
                background: #f9ca24;
            }
            @keyframes fall {
                to {
                    transform: translateY(100vh) rotate(360deg);
                }
            }
        </style>
    </head>
