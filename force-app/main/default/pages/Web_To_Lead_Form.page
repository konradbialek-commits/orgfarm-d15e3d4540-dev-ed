                <div class="progress-container">
                    <div class="progress-bar" id="prog"></div>
                </div>
                <div class="form-actions">
                    <button id="prev-btn" type="button" disabled="disabled">
                        Previous
                    </button>
                    <button id="next-btn" type="button">Next</button>
                    <button id="submit-btn" type="submit" style="display: none">
                        <span class="btn-txt">Submit</span>
                        <div class="spinner"></div>
                    </button>
                </div>
            </form>
            <footer class="footer">© 2026 BookSmart</footer>
        </div>
        <script>
            // ─── CONSTANTS ────────────────────────────────────────────────────────────────
            var REQUIRED = ["first_name", "last_name", "email", "company"];
            var currentStep = 1;
            var totalSteps = 3;
            var allFields = [
                "first_name",
                "last_name",
                "email",
                "mobile",
                "company",
                "city",
                "country_code",
                "fax",
            ];

            var VALIDATORS = {
                first_name: function (v) {
                    return /^[^\d]{2,40}$/.test(v.trim());
                },
                last_name: function (v) {
                    return /^[^\d]{2,80}$/.test(v.trim());
                },
                email: function (v) {
                    return /^[^\s@]+@[^\s@]+$/.test(v.trim());
                },
                company: function (v) {
                    return v.trim().length >= 2 && v.trim().length <= 40;
                },
                city: function (v) {
                    return /^[^\d]{2,40}$/.test(v.trim());
                },
                country_code: function (v) {
                    return v.trim() !== "";
                },
                mobile: function (v) {
                    return (
                        v.trim() === "" ||
                        /^[\d\s\+\-\(\)]{7,20}$/.test(v.trim())
                    );
                },
                fax: function (v) {
                    return (
                        v.trim() === "" ||
                        /^\+?[0-9\s\-\(\)\.]{7,20}$/.test(v.trim())
                    );
                },
            };

            // ─── STEP WIZARD ─────────────────────────────────────────────────────────────

            function setWrapperHeight(step) {
                var wrapper = document.querySelector(".steps-wrapper");
                var next = document.getElementById("step" + step);
                if (wrapper && next) {
                    wrapper.style.height = next.offsetHeight + "px";
                }
            }

            function showStep(step) {
                var current = document.querySelector(".step.active");
                var next = document.getElementById("step" + step);

                if (current && current !== next) {
                    current.classList.remove("active");
                    current.classList.add("leaving");
                }

                document.querySelectorAll(".step").forEach((s) => {
                    s.classList.remove("entering");
                });

                if (next) {
                    next.classList.remove("leaving");
                    next.classList.add("entering");
                    next.classList.add("active");
                }

                setWrapperHeight(step);

                window.setTimeout(function () {
                    document.querySelectorAll(".step.leaving").forEach((s) => {
                        s.classList.remove("leaving");
                    });
                    document.querySelectorAll(".step.entering").forEach((s) => {
                        s.classList.remove("entering");
                    });
                }, 500);

                var form = document.getElementById("wtl");
                if (form) form.setAttribute("data-step", step);

                document.querySelectorAll(".step-circle").forEach((c) => {
                    c.classList.remove("active", "completed");
                    if (parseInt(c.dataset.step) < step)
                        c.classList.add("completed");
                    if (parseInt(c.dataset.step) === step)
                        c.classList.add("active");
                });
                document.getElementById("prev-btn").disabled = step === 1;
                document.getElementById("next-btn").style.display =
                    step === totalSteps ? "none" : "inline-block";
                document.getElementById("submit-btn").style.display =
                    step === totalSteps ? "inline-block" : "none";
            }

            function getStepFields(step) {
                if (step === 1) return ["first_name", "last_name"];
                if (step === 2) return ["email", "mobile"];
                if (step === 3) return ["company", "fax"];
                return [];
            }

            // ─── BLOCK DISALLOWED CHARACTERS IN REAL TIME ─────────────────────────────────

            // First name, Last name, City — letters only (no digits)
            ["first_name", "last_name", "city"].forEach(function (id) {
                var el = document.getElementById(id);
                if (!el) return;
                el.addEventListener("keypress", function (e) {
                    if (/\d/.test(e.key)) {
                        e.preventDefault();
                    }
                });
                el.addEventListener("input", function () {
                    var sel = this.selectionStart;
                    var cleaned = this.value.replace(/\d/g, "");
                    if (cleaned !== this.value) {
                        this.value = cleaned;
                        this.setSelectionRange(sel - 1, sel - 1);
                    }
                });
            });

            // Phone — digits, spaces, +, -, (, ) only
            var mobileEl = document.getElementById("mobile");
            if (mobileEl) {
                mobileEl.addEventListener("keypress", function (e) {
                    if (
                        !/[\d\s\+\-\(\)]/.test(e.key) &&
                        e.key !== "Backspace" &&
                        e.key !== "Delete"
                    ) {
                        e.preventDefault();
                    }
                });
                mobileEl.addEventListener("input", function () {
                    var sel = this.selectionStart;
                    var cleaned = this.value.replace(/[^\d\s\+\-\(\)]/g, "");
                    if (cleaned !== this.value) {
                        this.value = cleaned;
                        this.setSelectionRange(sel - 1, sel - 1);
                    }
                });
            }

            // Fax — digits, spaces, +, -, (, ), . only
            var faxEl = document.getElementById("fax");
            if (faxEl) {
                faxEl.addEventListener("keypress", function (e) {
                    if (
                        !/[\d\s\+\-\(\)\.]/.test(e.key) &&
                        e.key !== "Backspace" &&
                        e.key !== "Delete"
                    ) {
                        e.preventDefault();
                    }
                });
                faxEl.addEventListener("input", function () {
                    var sel = this.selectionStart;
                    var cleaned = this.value.replace(/[^\d\s\+\-\(\)\.]/g, "");
                    if (cleaned !== this.value) {
                        this.value = cleaned;
                        this.setSelectionRange(sel - 1, sel - 1);
                    }
                });
            }

            // ─── FIELD VALIDATION ─────────────────────────────────────────────────────────

            function validateField(id, show) {
                var el = document.getElementById(id);
                var err = document.getElementById("e-" + id);
                if (!el) return true;
                var val = el.value;
                var empty = val.trim() === "";
                var isReq = REQUIRED.indexOf(id) > -1;
                var fn = VALIDATORS[id];
                var valid = fn ? fn(val) : true;
                var ok = isReq ? !empty && valid : empty || valid;
                el.classList.toggle("is-ok", ok && !empty);
                el.classList.toggle("is-err", show && !ok);
                el.parentElement.classList.toggle("is-valid", ok && !empty);
                if (err) err.classList.toggle("show", show && !ok);
                if (show && !ok) {
                    el.classList.add("shake");
                    setTimeout(() => el.classList.remove("shake"), 500);
                }
                return ok;
            }

            // ─── PROGRESS BAR ─────────────────────────────────────────────────────────────

            function updateProgress() {
                var validCount = 0;
                REQUIRED.forEach((id) => {
                    if (validateField(id, false)) validCount++;
                });
                var progress = (validCount / REQUIRED.length) * 100;
                document.getElementById("prog").style.width =
                    Math.round(progress) + "%";
            }

            // ─── FIELD EVENTS ─────────────────────────────────────────────────────────────

            [
                "first_name",
                "last_name",
                "email",
                "company",
                "city",
                "mobile",
                "fax",
            ].forEach(function (id) {
                var el = document.getElementById(id);
                if (!el) return;
                el.addEventListener("blur", function () {
                    validateField(id, true);
                    updateProgress();
                });
                el.addEventListener("input", function () {
                    validateField(id, true);
                    updateProgress();
                });
            });

            document
                .getElementById("country_code")
                .addEventListener("change", function () {
                    validateField("country_code", true);
                    updateProgress();
                });

            // ─── STEP NAVIGATION ─────────────────────────────────────────────────────────

            document
                .getElementById("next-btn")
                .addEventListener("click", function () {
                    var stepFields = getStepFields(currentStep);
                    var valid = true;
                    stepFields.forEach((id) => {
                        if (!validateField(id, true)) valid = false;
                    });
                    if (valid) {
                        currentStep++;
                        showStep(currentStep);
                        updateProgress();
                    }
                });

            document
                .getElementById("prev-btn")
                .addEventListener("click", function () {
                    currentStep--;
                    showStep(currentStep);
                    updateProgress();
                });

            // ─── CONFETTI ───────────────────────────────────────────────────────────────

            function createConfetti() {
                const confetti = document.createElement("div");
                confetti.className = "confetti";
                for (let i = 0; i < 50; i++) {
                    const piece = document.createElement("div");
                    piece.className = "confetti-piece";
                    piece.style.left = Math.random() * 100 + "%";
                    piece.style.animationDelay = Math.random() * 3 + "s";
                    confetti.appendChild(piece);
                }
                document.body.appendChild(confetti);
                setTimeout(() => document.body.removeChild(confetti), 5000);
            }

            // ─── SUBMIT ───────────────────────────────────────────────────────────────────

            document
                .getElementById("wtl")
                .addEventListener("submit", function (e) {
                    e.preventDefault();
                    var ok = true;
                    REQUIRED.forEach(function (id) {
                        if (!validateField(id, true)) ok = false;
                    });
                    if (!validateField("mobile", true)) ok = false;
                    if (!validateField("fax", true)) ok = false;
                    if (!ok) {
                        var first = document.querySelector(".is-err");
                        if (first)
                            first.scrollIntoView({
                                behavior: "smooth",
                                block: "center",
                            });
                        return;
                    }
                    var btn = document.getElementById("submit-btn");
                    btn.disabled = true;
                    btn.style.opacity = "0.65";
                    btn.style.pointerEvents = "none";
                    btn.classList.add("loading");
                    btn.querySelector(".btn-txt").textContent = "Sending...";
                    createConfetti();
                    setTimeout(() => {
                        e.target.submit();
                    }, 1000);
                });

            // Initialize
            showStep(currentStep);
            setWrapperHeight(currentStep);
            updateProgress();
        </script>
    </body>
</html>
