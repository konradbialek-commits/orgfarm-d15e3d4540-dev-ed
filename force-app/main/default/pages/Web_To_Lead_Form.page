                            <div class="field">
                                <input
                                    id="fax"
                                    maxlength="40"
                                    name="fax"
                                    size="20"
                                    type="text"
                                    pattern="^\+?[0-9\s\-\(\)\.]{7,20}$"
                                    title="Enter a valid fax number"
                                    placeholder="(555) 123-4567"
                                />
                                <label for="fax">Fax</label>
                                <span class="checkmark">✓</span>
                                <div class="errmsg" id="e-fax">
                                    <svg
                                        width="13"
                                        height="13"
                                        viewBox="0 0 13 13"
                                        fill="none"
                                    >
                                        <circle
                                            cx="6.5"
                                            cy="6.5"
                                            r="5.5"
                                            stroke="#DC2626"
                                            stroke-width="1.2"
                                        />
                                        <line
                                            x1="6.5"
                                            y1="4"
                                            x2="6.5"
                                            y2="7"
                                            stroke="#DC2626"
                                            stroke-width="1.4"
                                            stroke-linecap="round"
                                        />
                                        <circle
                                            cx="6.5"
                                            cy="9.5"
                                            r=".7"
                                            fill="#DC2626"
                                        />
