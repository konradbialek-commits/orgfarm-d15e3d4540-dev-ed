<apex:page showHeader="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" docType="html-5.0">
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link
            rel="shortcut icon"
            href="{!$Resource.SiteFavicon}"
            type="image/x-icon"
        />
        <title>Thank You</title>
        <style>
            body {
                font-family: Arial, sans-serif;
                line-height: 1.4;
                margin: 2rem 0 0 0;
                display: flex;
                flex-direction: column;
                background: url("https://i.postimg.cc/3N2751xX/booksmart-background-resized.png") center center / cover no-repeat;
                color: #333;
            }

            .main {
                display: flex;
                justify-content: center;
                align-items: center;
                flex: 1;
                min-height: 80vh;
            }

            .thank-you-container {
                background: #ffffff;
                max-width: 800px;
                min-width: 600px;
                padding: 1.5rem;
                border-radius: 10px;
                box-shadow: 0 6px 18px rgba(33, 53, 90, 0.12);
                border: 1px solid #e2e6ee;
                text-align: center;
            }

            img {
                display: block;
                max-width: 300px;
                height: auto;
                margin: 0 auto 1.5rem;
            }

            h1 {
                font-size: 2.5rem;
                margin-bottom: 1.5rem;
                color: #1f2a44;
                font-weight: 700;
            }

            p {
                font-size: 1.2rem;
                color: #333;
            }

            .footer {
                position: fixed;
                left: 0;
                bottom: 0;
                width: 100%;
                margin: 0;
                padding: 0.8rem 0;
                text-align: center;
                color: #334155;
                font-size: 0.9rem;
                background: rgba(255, 255, 255, 0.72);
                backdrop-filter: blur(10px);
                border-top: 1px solid rgba(226, 230, 238, 0.6);
                z-index: 10;
            }
        </style>
    </head>
    <body>
        <div class="main">
            <div class="thank-you-container">
                <img src="{!$Resource.BookSmartHeader}" alt="BookSmart Header" />
                <h1>Thank you!</h1>
                <p>
                    Thank you for submitting your information. We appreciate
                    your interest in BookSmart and will get back to you soon.
                </p>
                <footer class="footer">© 2026 BookSmart</footer>
            </div>
        </div>
    </body>
</html>
</apex:page>